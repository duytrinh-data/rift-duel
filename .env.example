# Frontend (Vite / Netlify)
# Local development: ws://localhost:2567
# Production (Render WSS): wss://rift-duel-server.onrender.com
VITE_GAME_SERVER_URL=ws://localhost:2567

# Backend Server (Render Web Service)
PORT=2567
NODE_ENV=development
# Comma-separated list of allowed frontend origins for CORS & WebSocket origin validation
ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,https://rift-duel.netlify.app
